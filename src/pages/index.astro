        font-size: 8px;
        letter-spacing: 0.38em;
        color: var(--gold);
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 34px;
        margin-left: auto;
      }

      .desktop-nav a {
        font-size: 13px;
        font-weight: 600;
        color: #5d5049;
        transition: color 0.2s;
      }

      .desktop-nav a:hover {
        color: var(--gold);
      }

      .nav-order {
        padding: 13px 19px;
        border-radius: 100px;
        background: var(--brown);
        color: white;
        font-size: 12px;
        font-weight: 700;
        transition: transform 0.2s, background 0.2s;
      }

      .nav-order:hover {
        transform: translateY(-2px);
        background: var(--brown-soft);
      }

      .mobile-toggle {
        display: none;
        border: 0;
        background: transparent;
        cursor: pointer;
      }

      .mobile-toggle span {
        width: 25px;
        height: 2px;
        display: block;
        background: var(--brown);
        margin: 5px 0;
      }

      .mobile-menu {
        display: none;
      }

      /* HERO */

      .hero {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: var(--cream);
        padding-top: 82px;
      }

      .hero-bg {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 80% 30%, rgba(184, 138, 74, 0.17), transparent 27%),
          radial-gradient(circle at 20% 80%, rgba(58, 33, 25, 0.08), transparent 30%);
      }

      .hero-content {
        position: relative;
        z-index: 2;
        width: min(1180px, calc(100% - 48px));
        margin: auto;
        display: grid;
        grid-template-columns: 1fr 0.9fr;
        gap: 70px;
        align-items: center;
      }

      .eyebrow,
      .section-label {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--gold);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.2em;
      }

      .eyebrow span {
        width: 35px;
        height: 1px;
        background: var(--gold);
      }

      .hero h1 {
        max-width: 700px;
        margin: 25px 0;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(58px, 7vw, 96px);
        line-height: 0.9;
        font-weight: 600;
        letter-spacing: -0.045em;
      }

      h1 em,
      h2 em {
        color: var(--gold);
        font-weight: 500;
      }

      .hero-copy > p {
        max-width: 560px;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        gap: 12px;
        margin-top: 35px;
      }

      .btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 0 25px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 700;
        transition: 0.25s;
      }

      .btn-primary {
        background: var(--brown);
        color: white;
      }

      .btn-primary:hover,
      .btn-dark:hover {
        transform: translateY(-3px);
      }

      .btn-outline {
        border: 1px solid var(--border);
      }

      .btn-outline:hover {
        border-color: var(--gold);
      }

      .hero-trust {
        display: flex;
        gap: 35px;
        margin-top: 60px;
      }

      .hero-trust div {
        display: flex;
        flex-direction: column;
      }

      .hero-trust strong {
        font-family: "Cormorant Garamond", serif;
        font-size: 19px;
      }

      .hero-trust span {
        margin-top: 3px;
        font-size: 10px;
        color: var(--muted);
      }

      .hero-product {
        min-height: 600px;
        position: relative;
        display: grid;
        place-items: center;
      }

      .hero-ring {
        position: absolute;
        width: 480px;
        height: 480px;
        border: 1px solid rgba(184, 138, 74, 0.35);
        border-radius: 50%;
      }

      .hero-ring::after {
        content: "";
        position: absolute;
        inset: 25px;
        border: 1px solid rgba(184, 138, 74, 0.18);
        border-radius: 50%;
      }

      .hero-image-wrap {
        position: relative;
        z-index: 2;
        width: min(430px, 80%);
        aspect-ratio: 0.85;
        overflow: hidden;
        border-radius: 220px 220px 20px 20px;
        box-shadow: 0 30px 80px rgba(36, 20, 15, 0.18);
      }

      .hero-image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .floating-card {
        position: absolute;
        z-index: 3;
        padding: 17px 20px;
        background: rgba(255, 253, 249, 0.94);
        box-shadow: 0 15px 40px rgba(36, 20, 15, 0.1);
        backdrop-filter: blur(10px);
      }

      .floating-card span {
        display: block;
        color: var(--gold);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .floating-card strong {
        display: block;
        margin-top: 3px;
        font-family: "Cormorant Garamond", serif;
        font-size: 21px;
      }

      .card-top {
        top: 100px;
        left: 0;
      }

      .card-bottom {
        right: 0;
        bottom: 100px;
      }

      .hero-scroll {
        position: absolute;
        bottom: 25px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #988b83;
        font-size: 8px;
        letter-spacing: 0.2em;
      }

      .hero-scroll div {
        width: 1px;
        height: 35px;
        background: #c4b7ae;
      }

      /* INTRO */

      .intro {
        background: var(--white);
      }

      .intro-grid {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 80px;
      }

      .section-label span {
        font-family: "DM Sans", sans-serif;
      }

      h2 {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(48px, 5vw, 70px);
        line-height: 0.95;
        font-weight: 600;
        letter-spacing: -0.04em;
      }

      .intro-content h2 {
        max-width: 700px;
      }

      .intro-content h2 span {
        display: block;
        color: var(--muted);
        font-weight: 400;
      }

      .intro-content p {
        max-width: 600px;
        margin-top: 35px;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.9;
      }

      /* MENU */

      .menu-section {
        background: var(--cream);
      }

      .section-heading {
        display: flex;
        justify-content: space-between;
        gap: 40px;
        align-items: end;
      }

      .section-heading h2 {
        margin-top: 20px;
      }

      .section-heading > p {
        max-width: 330px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
      }

      .category-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 55px 0 35px;
      }

      .filter {
        border: 1px solid var(--border);
        background: transparent;
        padding: 10px 17px;
        border-radius: 100px;
        color: var(--muted);
        font-size: 11px;
        cursor: pointer;
        transition: 0.2s;
      }

      .filter:hover,
      .filter.active {
        background: var(--brown);
        color: white;
        border-color: var(--brown);
      }

      .products-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
      }

      .product-card {
        transition: opacity 0.25s, transform 0.25s;
      }

      .product-card.hidden {
        display: none;
      }

      .product-image {
        position: relative;
        overflow: hidden;
        aspect-ratio: 0.95;
        background: #e7ddd0;
      }

      .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s;
      }

      .product-card:hover .product-image img {
        transform: scale(1.05);
      }

      .product-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        padding: 7px 11px;
        background: rgba(255, 253, 249, 0.9);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .product-plus {
        position: absolute;
        right: 15px;
        bottom: 15px;
        width: 38px;
        height: 38px;
        border: 0;
        border-radius: 50%;
        background: var(--brown);
        color: white;
        font-size: 20px;
      }

      .product-info {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 2px;
      }

      .product-info h3 {
        font-family: "Cormorant Garamond", serif;
        font-size: 25px;
        line-height: 1;
      }

      .product-info p {
        max-width: 250px;
        margin-top: 8px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.6;
      }

      .product-price {
        white-space: nowrap;
        color: var(--gold);
        font-size: 13px;
      }

      .menu-note {
        margin-top: 30px;
        color: #91857d;
        font-size: 10px;
      }

      .menu-note span {
        color: var(--gold);
      }

      /* SIGNATURE */

      .signature {
        background: var(--brown);
        color: white;
      }

      .signature-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 100px;
        align-items: center;
      }

      .signature-image {
        position: relative;
      }

      .signature-image > img {
        aspect-ratio: 0.9;
        object-fit: cover;
      }

      .signature-stamp {
        position: absolute;
        right: -30px;
        bottom: 35px;
        width: 115px;
        height: 115px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        background: var(--brown);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 0.8;
      }

      .signature-stamp span {
        font-family: "Cormorant Garamond", serif;
        font-size: 16px;
      }

      .signature-stamp strong {
        font-family: "Cormorant Garamond", serif;
        font-size: 28px;
        color: var(--gold);
      }

      .signature-stamp small {
        margin-top: 8px;
        font-size: 6px;
        letter-spacing: 0.2em;
      }

      .signature-content h2 {
        margin-top: 25px;
      }

      .signature-content h2 em {
        display: block;
      }

      .signature-content > p {
        max-width: 570px;
        margin-top: 30px;
        color: #cbbcb3;
        line-height: 1.9;
      }

      .signature-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin-top: 45px;
        padding-top: 25px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
      }

      .signature-details span {
        color: var(--gold);
        font-size: 10px;
      }

      .signature-details strong {
        display: block;
        margin-top: 7px;
        font-family: "Cormorant Garamond", serif;
        font-size: 19px;
      }

      .signature-details p {
        margin-top: 5px;
        color: #a9988f;
        font-size: 10px;
        line-height: 1.5;
      }

      .text-link {
        display: inline-flex;
        gap: 25px;
        margin-top: 45px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--gold);
        color: white;
        font-size: 12px;
        font-weight: 700;
      }

      .text-link span {
        color: var(--gold);
      }

      /* STORY */

      .story {
        background: var(--white);
      }

      .story-grid {
        display: grid;
        grid-template-columns: 0.6fr 1.4fr;
        gap: 80px;
      }

      .story-grid h2 {
        max-width: 600px;
      }

      .story-lead {
        max-width: 620px;
        margin-top: 35px;
        font-size: 18px;
        line-height: 1.8;
      }

      .story-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 35px;
        margin-top: 40px;
        padding-top: 35px;
        border-top: 1px solid var(--border);
      }

      .story-columns p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
      }

      /* FEATURES */

      .features {
        background: var(--cream);
        border-block: 1px solid var(--border);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .feature {
        display: flex;
        gap: 18px;
        padding: 55px 25px;
        border-right: 1px solid var(--border);
      }

      .feature:first-child {
        padding-left: 0;
      }

      .feature:last-child {
        border: 0;
      }

      .feature > span {
        color: var(--gold);
        font-size: 9px;
      }

      .feature strong {
        font-family: "Cormorant Garamond", serif;
        font-size: 21px;
      }

      .feature p {
        margin-top: 5px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.5;
      }

      /* GALLERY */

      .gallery {
        background: var(--white);
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr 0.7fr;
        grid-template-rows: 280px 280px;
        gap: 15px;
        margin-top: 55px;
      }

      .gallery-item {
        overflow: hidden;
      }

      .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s;
      }

      .gallery-item:hover img {
        transform: scale(1.04);
      }

      .gallery-large {
        grid-row: span 2;
      }

      .gallery-wide {
        grid-column: span 2;
      }

      /* LOCATION */

      .location {
        background: var(--cream);
      }

      .location-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 100px;
        align-items: center;
      }

      .location-content h2 {
        max-width: 600px;
        margin-top: 25px;
      }

      .location-content > p {
        max-width: 500px;
        margin-top: 25px;
        color: var(--muted);
        line-height: 1.8;
      }

      .location-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
        margin: 40px 0;
      }

      .location-info div {
        padding-top: 15px;
        border-top: 1px solid var(--border);
      }

      .location-info span {
        display: block;
        color: var(--gold);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.18em;
      }

      .location-info strong {
        display: block;
        margin-top: 7px;
        font-family: "Cormorant Garamond", serif;
        font-size: 17px;
      }

      .btn-dark {
        background: var(--brown);
        color: white;
      }

      .map-card {
        min-height: 500px;
        position: relative;
        overflow: hidden;
        background:
          linear-gradient(30deg, transparent 48%, rgba(36,20,15,.08) 49%, transparent 51%),
          linear-gradient(-30deg, transparent 48%, rgba(36,20,15,.06) 49%, transparent 51%),
          #e9dfd1;
        background-size: 90px 90px;
        box-shadow: 0 25px 70px rgba(36, 20, 15, 0.12);
      }

      .map-card::before,
      .map-card::after {
        content: "";
        position: absolute;
        background: rgba(255, 253, 249, 0.8);
      }

      .map-card::before {
        width: 120%;
        height: 30px;
        left: -10%;
        top: 50%;
        transform: rotate(-17deg);
      }

      .map-card::after {
        width: 120%;
        height: 20px;
        left: -10%;
        top: 35%;
        transform: rotate(30deg);
      }

      .map-pin {
        position: absolute;
        z-index: 2;
        left: 50%;
        top: 48%;
        transform: translate(-50%, -50%);
        text-align: center;
      }

      .map-pin div {
        width: 60px;
        height: 60px;
        margin: auto;
        display: grid;
        place-items: center;
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        background: var(--brown);
        color: var(--gold);
        font-family: "Cormorant Garamond", serif;
        font-size: 27px;
      }

      .map-pin div::first-letter {
        transform: rotate(45deg);
      }

      .map-pin span {
        display: block;
        margin-top: 25px;
        padding: 7px 10px;
        background: white;
        font-size: 9px;
        font-weight: 700;
      }

      .map-label {
        position: absolute;
        z-index: 2;
        color: #796d65;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.12em;
      }

      .label-one {
        left: 12%;
        top: 22%;
      }

      .label-two {
        right: 12%;
        bottom: 22%;
      }

      /* CTA */

      .cta {
        position: relative;
        overflow: hidden;
        background: var(--brown);
        color: white;
        padding: 130px 0;
        text-align: center;
      }

      .cta::before,
      .cta::after {
        content: "";
        position: absolute;
        width: 450px;
        height: 450px;
        border: 1px solid rgba(184, 138, 74, 0.2);
        border-radius: 50%;
      }

      .cta::before {
        left: -250px;
        top: -200px;
      }

      .cta::after {
        right: -250px;
        bottom: -250px;
      }

      .cta-content {
        position: relative;
        z-index: 2;
      }

      .cta h2 {
        max-width: 800px;
        margin: 25px auto 0;
      }

      .cta p {
        max-width: 500px;
        margin: 25px auto 35px;
        color: #c5b5ab;
        line-height: 1.8;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        padding: 16px 25px;
        border-radius: 100px;
        background: #f5eee5;
        color: var(--brown);
        font-size: 12px;
        font-weight: 700;
        transition: 0.25s;
      }

      .cta-button:hover {
        transform: translateY(-3px);
      }

      .wa-icon {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #2baa5b;
        color: white;
      }

      /* FAQ */

      .faq {
        background: var(--white);
      }

      .faq-grid {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 100px;
      }

      .faq h2 {
        margin-top: 25px;
      }

      .faq-list {
        border-top: 1px solid var(--border);
      }

      details {
        border-bottom: 1px solid var(--border);
      }

      summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 23px 0;
        list-style: none;
        cursor: pointer;
        font-family: "Cormorant Garamond", serif;
        font-size: 21px;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      summary span {
        color: var(--gold);
        font-family: "DM Sans", sans-serif;
        font-size: 20px;
        transition: transform 0.2s;
      }

      details[open] summary span {
        transform: rotate(45deg);
      }

      details p {
        max-width: 700px;
        padding: 0 0 25px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
      }

      /* FOOTER */

      footer {
        background: #1c100d;
        color: white;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 50px;
        padding: 75px 0;
      }

      .footer-brand p {
        margin-top: 25px;
        color: #98867d;
        font-family: "Cormorant Garamond", serif;
        font-size: 20px;
        line-height: 1.2;
      }

      .footer-column {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }

      .footer-column > span:first-child {
        margin-bottom: 10px;
        color: var(--gold);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.2em;
      }

      .footer-column a,
      .footer-column > span:not(:first-child) {
        color: #a9988f;
        font-size: 11px;
      }

      .footer-column a:hover {
        color: white;
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        padding: 22px 0;
        border-top: 1px solid rgba(255,255,255,0.1);
        color: #76645c;
        font-size: 9px;
      }

      .floating-wa {
        position: fixed;
        z-index: 900;
        right: 22px;
        bottom: 22px;
        width: 56px;
        height: 56px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #2baa5b;
        color: white;
        font-size: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,.2);
        transition: 0.25s;
      }

      .floating-wa:hover {
        transform: translateY(-4px) scale(1.04);
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .desktop-nav,
        .nav-order {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }

        .mobile-menu {
          padding: 10px 24px 25px;
          border-top: 1px solid var(--border);
          background: var(--white);
        }

        .mobile-menu.show {
          display: flex;
          flex-direction: column;
          gap: 18px;
        }

        .mobile-menu a {
          font-size: 13px;
          font-weight: 600;
        }

        .mobile-order {
          padding: 14px;
          text-align: center;
          border-radius: 100px;
          background: var(--brown);
          color: white;
        }

        .hero-content,
        .signature-grid,
        .location-grid,
        .faq-grid {
          grid-template-columns: 1fr;
        }

        .hero {
          padding-top: 120px;
          padding-bottom: 80px;
        }

        .hero-product {
          min-height: 520px;
        }

        .intro-grid,
        .story-grid {
          grid-template-columns: 1fr;
          gap: 35px;
        }

